<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0d1824">
  <title><%= locals.title ? `${title} | Lionheart Trade` : `${settings.company_name} | China Sourcing, Cargo & Trade` %></title>
<% const pageTitle = locals.title ? `${title} | Lionheart Trade` : `${settings.company_name} | China Sourcing, Cargo & Trade`;
   // Link previews (WhatsApp, Facebook, X, LinkedIn…): company name, a short description and the logo.
   const shareTitle = locals.title ? pageTitle : settings.company_name;
   const pageDescription = locals.description || `${settings.tagline} Machinery, vehicles, building materials, tiles, solar and more, shipped from China and Dubai to Liberia and Guinea.`;
   const base = locals.siteUrl || '';
   const pageUrl = base + (locals.path || '/');
   const ownImage = Boolean(locals.shareImage);
   const shareImage = ownImage ? (/^https?:/.test(locals.shareImage) ? locals.shareImage : base + locals.shareImage) : base + asset('/static/img/og-logo.jpg'); %>
  <meta name="description" content="<%= pageDescription %>">
  <link rel="canonical" href="<%= pageUrl %>">
  <% if (locals.noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <meta property="og:type" content="<%= locals.product ? 'product' : 'website' %>">
  <meta property="og:site_name" content="<%= settings.company_name %>">
  <meta property="og:locale" content="<%= locals.lang === 'fr' ? 'fr_FR' : 'en_US' %>">
  <meta property="og:locale:alternate" content="<%= locals.lang === 'fr' ? 'en_US' : 'fr_FR' %>">
  <meta property="og:title" content="<%= shareTitle %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:url" content="<%= pageUrl %>">
  <meta property="og:image" content="<%= shareImage %>">
  <% if (/^https:/.test(shareImage)) { %><meta property="og:image:secure_url" content="<%= shareImage %>"><% } %>
  <% if (!ownImage) { %><meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="1200"><% } %>
  <meta property="og:image:alt" content="<%= settings.company_name %>">
  <meta name="twitter:card" content="<%= ownImage ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= shareTitle %>">
  <meta name="twitter:description" content="<%= pageDescription %>">
  <meta name="twitter:image" content="<%= shareImage %>">
  <link rel="image_src" href="<%= shareImage %>">
  <link rel="icon" href="/static/img/favicon.png">
  <link rel="apple-touch-icon" href="/static/img/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="preload" href="/vendor/fonts/schibsted-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= asset('/static/css/style.css') %>">
  <% if (locals.path === '/' || locals.product) { %><%- include('jsonld') %><% } %>
</head>
