<%- include('partials/header') %>
<section class="hero">
  <div class="container">
    <div class="hero-copy">
      <div class="eyebrow" data-anim="eyebrow"><span></span> Guangzhou &middot; Dubai &middot; Monrovia</div>
      <h1><span class="line-wrap"><span class="line">Sourced in <em>China</em>,</span></span><span class="line-wrap"><span class="line">delivered by Lionheart.</span></span></h1>
      <p class="lead" data-anim="lead">One trusted partner between you and thousands of factories. We find the supplier, buy, inspect, ship and clear your goods.<span class="lead-more"> Or buy what we already hold in stock, ready to go.</span></p>
      <div class="cta">
        <a class="btn btn-gold btn-lg" href="/products">Browse the catalog <%- icon('arrow', 18, 'arrow') %></a>
        <a class="btn btn-glass btn-lg" href="/request">Request a product</a>
      </div>
      <div class="hero-stats">
        <div><strong data-count="<%= totals.products %>"><%= totals.products %></strong><span>Products listed</span></div>
        <div><strong data-count="<%= totals.categories %>"><%= totals.categories %></strong><span>Categories</span></div>
        <div><strong data-count="3">3</strong><span>Trade hubs</span></div>
      </div>
    </div>
    <div class="hero-visual">
      <div id="hero-globe" aria-hidden="true"></div>
      <ul class="hero-legend">
        <li><span class="code">CAN</span><div><strong>Guangzhou, China</strong><small>Sourcing, purchasing &amp; inspection</small></div></li>
        <li><span class="code">DXB</span><div><strong>Dubai, UAE</strong><small>Ready stock &amp; re-export</small></div></li>
        <li><span class="code">MLW</span><div><strong>Monrovia, Liberia</strong><small>Clearing, forwarding &amp; delivery</small></div></li>
      </ul>
    </div>
  </div>
  <div class="hero-fade"></div>
</section>

<div class="ribbon" aria-hidden="true">
  <div class="ribbon-track">
    <% const ribbon = ['Heavy equipment', 'Building materials', 'Decra & zinc roofing', 'Porcelain tiles', 'Solar & electrical', 'Vehicles', 'Machinery', 'Furniture', 'Sanitary ware', 'Doors & windows', 'Electronics']; %>
    <% [0, 1].forEach(() => { ribbon.forEach(r => { %><span><%= r %></span><% }) }) %>
  </div>
</div>

<div class="container">
  <div class="two-ways">
    <a class="way way-source" href="/products?mode=source">
      <span class="way-num">01 — Factory direct</span>
      <h3>Order directly from China</h3>
      <p>Factory prices on bulk and project orders. We handle the buying, the checks and the shipping.</p>
      <ul><li>Verified manufacturers, negotiated prices</li><li>Inspection before loading</li><li>Sea, air or RoRo to your port</li></ul>
      <span class="way-link">Shop factory-direct <%- icon('arrow', 16) %></span>
    </a>
    <a class="way way-stock" href="/products?mode=stock">
      <span class="way-num">02 — Ready stock</span>
      <h3>Buy from Lionheart stock</h3>
      <p>Goods already in our warehouse, available now, with no factory minimum order.</p>
      <ul><li>Faster delivery</li><li>Small quantities welcome</li><li>See it before you buy</li></ul>
      <span class="way-link">Shop ready stock <%- icon('arrow', 16) %></span>
    </a>
  </div>

  <section class="section">
    <div class="section-head">
      <div><span class="kicker">The catalog</span><h2>Shop by category</h2></div>
      <div class="spacer"></div>
      <a href="/products">View all products <%- icon('arrow', 16) %></a>
    </div>
    <div class="cat-grid">
      <% categoriesNav.forEach((c, i) => { %>
        <a class="cat-tile" href="/products?category=<%= c.slug %>">
          <span class="ci"><%- icon(c.icon, 20) %></span>
          <strong><%= c.name %></strong>
          <span class="go"><span><%= String(counts[c.id] || 0).padStart(2, '0') %> item<%= (counts[c.id] || 0) === 1 ? '' : 's' %></span><%- icon('arrow', 18) %></span>
          <small><%= c.description || `${counts[c.id] || 0} product${(counts[c.id] || 0) === 1 ? '' : 's'}` %></small>
        </a>
      <% }) %>
    </div>
  </section>

  <% if (featured.length) { %>
  <section class="section">
    <div class="section-head">
      <div><span class="kicker">Selected for you</span><h2>Featured products</h2></div>
      <div class="spacer"></div>
      <a href="/products">See the full range <%- icon('arrow', 16) %></a>
    </div>
    <div class="product-grid"><% featured.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %></div>
  </section>
  <% } %>

  <section class="section">
    <div class="section-head">
      <div><span class="kicker">Door to door</span><h2>Everything between the factory and your site</h2></div>
      <div class="spacer"></div>
      <p>Clearing &amp; forwarding is our core business. We take care of each step so you deal with one team, not ten.</p>
    </div>
    <div class="services">
      <div class="service"><span class="n">01</span><%- icon('search', 26) %><h3>Sourcing</h3><p>We find and vet manufacturers for the exact specification, quantity and budget you need.</p></div>
      <div class="service"><span class="n">02</span><%- icon('handshake', 26) %><h3>Purchasing</h3><p>We negotiate prices and terms, place the order and follow production for you.</p></div>
      <div class="service"><span class="n">03</span><%- icon('scan', 26) %><h3>Quality inspection</h3><p>Goods are checked at our warehouse before loading, so you receive what you paid for.</p></div>
      <div class="service"><span class="n">04</span><%- icon('layers', 26) %><h3>Consolidation</h3><p>Orders from several suppliers are combined and packed to save on freight.</p></div>
      <div class="service"><span class="n">05</span><%- icon('ship', 26) %><h3>Freight</h3><p>Full or shared containers, air freight, or RoRo for vehicles and heavy machinery.</p></div>
      <div class="service"><span class="n">06</span><%- icon('stamp', 26) %><h3>Customs &amp; delivery</h3><p>Documents, duties and clearing at the port, then delivery to your door or site.</p></div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div><span class="kicker">How ordering works</span><h2>From cart to container in four steps</h2></div>
      <div class="spacer"></div>
      <a href="/how-it-works">Learn more <%- icon('arrow', 16) %></a>
    </div>
    <div class="steps">
      <div class="st"><div class="si"><%- icon('cart') %></div><h3>Choose your products</h3><p>Pick China sourcing or ready stock for each item and set the quantity.</p></div>
      <div class="st"><div class="si"><%- icon('clipboard') %></div><h3>Receive a quotation</h3><p>We confirm price, shipping and delivery time, usually within 24–48 hours.</p></div>
      <div class="st"><div class="si"><%- icon('shield') %></div><h3>Accept &amp; pay</h3><p>Accept online. We purchase from the supplier and inspect your goods.</p></div>
      <div class="st"><div class="si"><%- icon('ship') %></div><h3>We ship &amp; deliver</h3><p>Freight, customs and delivery handled. Follow every step online.</p></div>
    </div>
  </section>

  <% if (latest.length) { %>
  <section class="section">
    <div class="section-head">
      <div><span class="kicker">Just arrived</span><h2>Newly added</h2></div>
      <div class="spacer"></div>
      <a href="/products?sort=newest">See all <%- icon('arrow', 16) %></a>
    </div>
    <div class="product-grid"><% latest.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %></div>
  </section>
  <% } %>

  <div class="cta-band">
    <div><h2>Need something that's <em>not listed</em>?</h2><p>Send us a photo or a description. Our team in China will find the manufacturer and come back with prices and options.</p></div>
    <div class="spacer"></div>
    <a class="btn btn-gold btn-lg" href="/request">Request a product <%- icon('arrow', 18, 'arrow') %></a>
    <% if (settings.whatsapp) { %><a class="btn btn-glass btn-lg" href="https://wa.me/<%= settings.whatsapp.replace(/\D/g, '') %>" target="_blank" rel="noopener"><%- icon('chat') %> WhatsApp us</a><% } %>
  </div>
</div>
<%- include('partials/footer') %>
