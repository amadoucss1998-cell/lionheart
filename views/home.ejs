<%- include('partials/header') %>
<section class="hero">
  <div class="container">
    <div class="hero-copy">
      <div class="eyebrow" data-anim="eyebrow">Guangzhou, Dubai, Monrovia, Conakry</div>
      <h1><span class="line-wrap"><span class="line"><%- t('Sourced in <em>China</em>,') %></span></span><span class="line-wrap"><span class="line"><%- t('delivered by Lionheart.') %></span></span></h1>
      <p class="lead" data-anim="lead">One partner between you and thousands of Chinese factories. We source, buy, inspect, ship and clear your goods.</p>
      <div class="cta">
        <a class="btn btn-gold btn-lg" href="/products">Browse the catalog <%- icon('arrow', 18, 'arrow') %></a>
        <a class="btn btn-glass btn-lg" href="/request">Request a product</a>
      </div>
    </div>
    <div class="hero-visual">
      <div id="hero-globe" aria-hidden="true" data-src="<%= asset('/static/js/hero3d.js') %>"></div>
      <ul class="hero-legend">
        <li><span class="code">CAN</span><div><strong>Guangzhou, China</strong><small>Sourcing, purchasing &amp; inspection</small></div></li>
        <li><span class="code">DXB</span><div><strong>Dubai, UAE</strong><small>Ready stock &amp; re-export</small></div></li>
        <li><span class="code">MLW</span><div><strong>Monrovia, Liberia</strong><small>Head office, clearing &amp; delivery</small></div></li>
        <li><span class="code">CKY</span><div><strong>Kipé, Conakry, Guinea</strong><small>Clearing, forwarding &amp; delivery</small></div></li>
      </ul>
    </div>
  </div>
  <div class="hero-fade"></div>
</section>

<div class="ribbon" aria-hidden="true">
  <div class="ribbon-track">
    <% const ribbon = ['Heavy equipment', 'Building materials', 'Decra & zinc roofing', 'Porcelain tiles', 'Solar & electrical', 'Vehicles', 'Machinery', 'Furniture', 'Sanitary ware', 'Doors & windows', 'Electronics']; %>
    <% [0, 1].forEach(() => { ribbon.forEach(r => { %><span><%= r %></span><% }) }) %>
  </div>
</div>

<div class="container">
  <div class="two-ways">
    <a class="way way-source" href="/products?mode=source">
      <span class="way-num">Factory direct</span>
      <h3>Order directly from China</h3>
      <p>Factory prices on bulk and project orders. We handle the buying, the checks and the shipping.</p>
      <ul><li>Verified manufacturers, negotiated prices</li><li>Inspection before loading</li><li>Sea, air or RoRo to your port</li></ul>
      <span class="way-link">Shop factory-direct <%- icon('arrow', 16) %></span>
    </a>
    <a class="way way-stock" href="/products?mode=stock">
      <span class="way-num">Ready stock</span>
      <h3>Buy from Lionheart stock</h3>
      <p>Goods already in our warehouse, available now, with no factory minimum order.</p>
      <ul><li>Faster delivery</li><li>Small quantities welcome</li><li>See it before you buy</li></ul>
      <span class="way-link">Shop ready stock <%- icon('arrow', 16) %></span>
    </a>
  </div>

  <section class="section">
    <div class="section-head">
      <div><h2>Shop by category</h2></div>
      <div class="spacer"></div>
      <a href="/products">Browse the catalog <%- icon('arrow', 16) %></a>
    </div>
    <div class="cat-grid">
      <% categoriesNav.forEach((c, i) => { %>
        <a class="cat-tile" href="/products?category=<%= c.slug %>">
          <span class="ci"><%- icon(c.icon, 20) %></span>
          <strong><%= c.name %></strong>
          <span class="go"><span><%= String(counts[c.id] || 0).padStart(2, '0') %> item<%= (counts[c.id] || 0) === 1 ? '' : 's' %></span><%- icon('arrow', 18) %></span>
          <small><%= c.description || `${counts[c.id] || 0} product${(counts[c.id] || 0) === 1 ? '' : 's'}` %></small>
        </a>
      <% }) %>
      <% if (categoriesNav.length % 2) { %>
        <a class="cat-tile cat-tile-request" href="/request">
          <span class="ci"><%- icon('plus', 20) %></span>
          <strong>Something else?</strong>
          <span class="go"><span>On request</span><%- icon('arrow', 18) %></span>
          <small>Most of what we source is not listed. Tell us what you need.</small>
        </a>
      <% } %>
    </div>
  </section>

  <% if (featured.length) { %>
  <section class="section">
    <div class="section-head">
      <div><h2><%- t('Featured <em>products</em>') %></h2></div>
      <div class="spacer"></div>
      <a href="/products">Browse the catalog <%- icon('arrow', 16) %></a>
    </div>
    <div class="product-grid<%= featured.length === 5 ? ' bento' : '' %>"><% featured.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %></div>
  </section>
  <% } %>

  <section class="section">
    <div class="section-head">
      <div><h2><%- t('Everything between the factory <em>and your site</em>') %></h2><p class="section-lede">Clearing and forwarding is our core business. You deal with one team, not ten.</p></div>
    </div>
    <div class="services bento">
      <div class="service"><%- icon('search', 26) %><h3>Sourcing</h3><p>We find and vet manufacturers for the exact specification, quantity and budget you need.</p></div>
      <div class="service"><%- icon('handshake', 26) %><h3>Purchasing</h3><p>We negotiate prices and terms, place the order and follow production for you.</p></div>
      <div class="service"><%- icon('scan', 26) %><h3>Quality inspection</h3><p>Goods are checked at our warehouse before loading, so you receive what you paid for.</p></div>
      <div class="service"><%- icon('layers', 26) %><h3>Consolidation</h3><p>Orders from several suppliers are combined and packed to save on freight.</p></div>
      <div class="service"><%- icon('ship', 26) %><h3>Freight</h3><p>Full or shared containers, air freight, or RoRo for vehicles and heavy machinery.</p></div>
      <div class="service"><%- icon('stamp', 26) %><h3>Customs &amp; delivery</h3><p>Documents, duties and clearing at the port, then delivery to your door or site.</p></div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div><h2><%- t('From cart to container in <em>four steps</em>') %></h2></div>
      <div class="spacer"></div>
      <a href="/how-it-works">Learn more <%- icon('arrow', 16) %></a>
    </div>
    <div class="steps">
      <div class="st"><div class="si"><%- icon('cart') %></div><h3>Choose your products</h3><p>Pick China sourcing or ready stock for each item and set the quantity.</p></div>
      <div class="st"><div class="si"><%- icon('clipboard') %></div><h3>Receive a quotation</h3><p>We confirm price, shipping and delivery time, usually within 24 to 48 hours.</p></div>
      <div class="st"><div class="si"><%- icon('shield') %></div><h3>Accept &amp; pay</h3><p>Accept online. We purchase from the supplier and inspect your goods.</p></div>
      <div class="st"><div class="si"><%- icon('ship') %></div><h3>We ship &amp; deliver</h3><p>Freight, customs and delivery handled. Follow every step online.</p></div>
    </div>
  </section>

  <% if (latest.length) { %>
  <section class="section">
    <div class="section-head">
      <div><h2><%- t('Newly <em>added</em>') %></h2></div>
      <div class="spacer"></div>
      <a href="/products?sort=newest">See all <%- icon('arrow', 16) %></a>
    </div>
    <div class="product-grid"><% latest.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %></div>
  </section>
  <% } %>

  <% if (testimonials.items.length) { %>
  <section class="section">
    <div class="section-head">
      <div><h2>What our customers say</h2></div>
      <div class="spacer"></div>
      <div class="rating-summary">
        <strong><%= testimonials.stats.average.toFixed(1) %></strong>
        <div><%- include('partials/stars', { rating: testimonials.stats.average, size: 18 }) %><span><%= testimonials.stats.count %> review<%= testimonials.stats.count === 1 ? '' : 's' %></span></div>
      </div>
    </div>
    <div class="reviews-grid<%= testimonials.items.length === 5 ? ' bento' : '' %>">
      <% testimonials.items.forEach(r => { %>
        <figure class="review">
          <div class="row" style="gap:10px"><%- include('partials/stars', { rating: r.rating }) %><% if (r.source === 'sample') { %><span class="tag tag-muted" title="Example review for this demo">Sample</span><% } %></div>
          <blockquote><%= r.body %></blockquote>
          <figcaption>
            <span class="avatar" aria-hidden="true"><%= r.name.split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase() %></span>
            <span><strong><%= r.name %></strong><small><%= [r.company, r.country].filter(Boolean).join(' · ') %></small></span>
          </figcaption>
        </figure>
      <% }) %>
    </div>
  </section>
  <% } %>

  <section class="section faq-section">
    <div class="faq-layout">
      <div>
        <h2><%- t('Before you <em>order</em>') %></h2>
        <p class="muted">Anything else? Our team answers on WhatsApp and email.</p>
        <% if (settings.whatsapp) { %><a class="btn btn-ghost mt-2" href="https://wa.me/<%= settings.whatsapp.replace(/\D/g, '') %>" target="_blank" rel="noopener"><%- icon('chat', 18) %> Ask us on WhatsApp</a><% } %>
      </div>
      <div class="faq">
        <details open><summary>Do I pay when I place an order?</summary><p>No. Your order is a request for a quotation. We confirm the final price, shipping and delivery time first, and you only pay after you accept the quote online.</p></details>
        <details><summary>What is the difference between "From China" and "In stock"?</summary><p>"From China" means we buy from the factory for you at factory prices, usually with a minimum order quantity. "In stock" items are already in our warehouse, so you get them faster and can order smaller quantities.</p></details>
        <details><summary>How long does delivery take?</summary><p>It depends on the product, the factory's production time and the shipping method you choose: sea freight (full or shared container), air freight or RoRo for vehicles and machinery. Your quotation states the expected timeline before you commit.</p></details>
        <details><summary>Do you check the goods before shipping?</summary><p>Yes. Goods are inspected at our warehouse before loading. If something is not right, we deal with the supplier before your goods leave China.</p></details>
        <details><summary>Can you find a product that is not on the website?</summary><p>Yes, most of what we source is not listed. Send a photo or a description through "Request a product" and our team will come back with options and prices.</p></details>
        <details><summary>Do you handle customs clearing?</summary><p>Clearing and forwarding is our core business. We prepare the documents, handle duties and clearing at the port, and can deliver to your door or site.</p></details>
        <details><summary>How do I follow my order?</summary><p>Every order has its own page showing each stage, from purchasing and inspection to shipping, arrival and delivery, including the container or tracking number. Use "Track an order" or your account.</p></details>
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div><h2><%- t("Need something that's <em>not listed</em>?") %></h2><p>Send us a photo or a description. Our team in China will find the manufacturer and come back with prices and options.</p></div>
    <div class="cta-actions">
      <a class="btn btn-gold btn-lg" href="/request">Request a product <%- icon('arrow', 18, 'arrow') %></a>
      <% if (settings.whatsapp) { %><a class="btn btn-ghost btn-lg" href="https://wa.me/<%= settings.whatsapp.replace(/\D/g, '') %>" target="_blank" rel="noopener"><%- icon('chat') %> Ask us on WhatsApp</a><% } %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
