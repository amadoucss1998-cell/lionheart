<%- include('partials/header') %>
<div class="container page">
  <div class="page-head"><h1>Your cart</h1></div>
  <% if (!lines.length) { %>
    <div class="card empty">
      <%- icon('cart', 48) %>
      <h2>Your cart is empty</h2>
      <p>Browse the catalog and add products from China or from our stock.</p>
      <a class="btn btn-gold" href="/products">Browse products</a>
    </div>
  <% } else { %>
  <div class="cart-layout">
    <div>
      <form id="cart-form" method="post" action="/cart/update" class="card">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <% lines.forEach(l => { %>
          <div class="cart-item">
            <a class="ci-img" href="/products/<%= l.product.slug %>"><% if (l.product.images.length) { %><img src="/uploads/<%= l.product.images[0].filename %>" alt=""><% } else { %><div class="placeholder"><%- icon(l.product.category_icon || 'box', 28) %></div><% } %></a>
            <div>
              <a href="/products/<%= l.product.slug %>"><strong><%= l.product.name %></strong></a>
              <div class="mt-1"><span class="tag tag-<%= l.mode %>"><%= h.MODES[l.mode].short %></span>
                <span class="small muted">&nbsp;<%= l.price !== null && l.price !== undefined ? `${fmt(l.price)} / ${l.product.unit}` : 'Price on request' %></span></div>
              <div class="ci-controls">
                <label class="sr-only" for="qty<%= l.index %>">Quantity</label>
                <input id="qty<%= l.index %>" type="number" name="qty_<%= l.index %>" min="<%= l.mode === 'source' ? l.product.moq : 1 %>" value="<%= l.qty %>">
                <span class="small muted"><%= l.product.unit %>(s)</span>
                <label class="sr-only" for="notes<%= l.index %>">Notes</label>
                <input id="notes<%= l.index %>" type="text" name="notes_<%= l.index %>" value="<%= l.notes %>" placeholder="Colour, size, spec notes (optional)">
                <button class="btn btn-danger btn-sm" type="submit" form="remove-<%= l.index %>">Remove</button>
              </div>
              <% if (l.mode === 'source' && l.product.moq > 1) { %><div class="hint">Factory minimum: <%= l.product.moq %> <%= l.product.unit %>(s)</div><% } %>
            </div>
            <div class="ci-total right"><strong><%= l.lineTotal !== null ? fmt(l.lineTotal) : 'Quote' %></strong></div>
          </div>
        <% }) %>
        <div class="card-body row"><a href="/products" class="btn btn-ghost btn-sm">← Continue shopping</a><div class="spacer"></div><button class="btn btn-outline btn-sm" type="submit">Update cart</button></div>
      </form>
      <% lines.forEach(l => { %>
        <form id="remove-<%= l.index %>" method="post" action="/cart/remove"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="index" value="<%= l.index %>"></form>
      <% }) %>
    </div>
    <aside class="card summary"><div class="card-body">
      <h2>Order summary</h2>
      <div class="line"><span>Items</span><span><%= lines.length %></span></div>
      <div class="line"><span>Estimated goods value</span><span><%= fmt(estimate) %></span></div>
      <div class="line muted small"><span>Shipping &amp; customs</span><span>In quotation</span></div>
      <div class="line total"><span>Estimate</span><span><%= fmt(estimate) %><%= hasUnpriced ? ' +' : '' %></span></div>
      <% if (hasUnpriced) { %><p class="small muted">Some items are priced on request. We will include them in your quotation.</p><% } %>
      <a class="btn btn-gold btn-block btn-lg mt-2" href="/checkout">Request quotation &amp; order</a>
      <p class="small muted mt-2 mb-0">You won't pay now. We confirm the final price, shipping and delivery time first. You only pay after you accept.</p>
    </div></aside>
  </div>
  <% } %>
</div>
<%- include('partials/footer') %>
