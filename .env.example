# Copy to .env and fill in. Never commit the real .env file.

# --- Required in production -------------------------------------------------
# Your domain, without https:// (used by docker-compose + Caddy for HTTPS).
DOMAIN=shop.lionheartgroup.info
# Public address of the site (docker-compose sets this from DOMAIN automatically).
PUBLIC_URL=https://shop.lionheartgroup.info
# Long random string. Generate one with:  openssl rand -hex 32
SESSION_SECRET=
# First admin account (only used when no admin exists yet).
ADMIN_EMAIL=lionheartgroupinfo@gmail.com
ADMIN_PASSWORD=

# --- Supabase (database + photo storage) ------------------------------------
# Required on Vercel. Optional elsewhere: without them the app uses a built-in
# database and stores photos on disk in DATA_DIR.
# Database: Supabase → Connect → "Transaction pooler" connection string (port 6543).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Photos: Supabase → Project Settings → API keys. Keep the service_role key secret.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for photos (created automatically, public).
SUPABASE_BUCKET=lionheart-uploads

# Load sample products on first start (set to false for an empty catalog).
SEED_DEMO=true

# --- Email alerts (Gmail example: needs a Google "App password") -------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=lionheartgroupinfo@gmail.com
SMTP_PASS=
MAIL_FROM=Lionheart Alerts <lionheartgroupinfo@gmail.com>

# --- WhatsApp alerts: pick ONE provider (see README) -------------------------
# WHATSAPP_PROVIDER=callmebot
# CALLMEBOT_RECIPIENTS=231888979704:YOUR_API_KEY

# WHATSAPP_PROVIDER=cloud
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=new_order_alert
# WHATSAPP_TEMPLATE_LANG=en

# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
