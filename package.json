{
  "name": "lionheart-trade-portal",
  "version": "1.0.0",
  "description": "Lionheart Group product catalog, China sourcing and ordering portal",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "test": "node --test \"test/*.test.js\"",
    "backup": "node src/backup.js",
    "test:e2e": "node --test \"test/e2e/*.e2e.js\"",
    "vercel-build": "npm run build:js && node scripts/copy-vendor.js && node scripts/fetch-stock-photos.js",
    "test:postgres": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "photos": "node scripts/fetch-stock-photos.js",
    "build:js": "esbuild src/client/hero3d.js --bundle --minify --format=esm --target=es2020 --legal-comments=none --outfile=public/static/js/hero3d.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amadoucss1998-cell/lionheart.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/amadoucss1998-cell/lionheart/issues"
  },
  "homepage": "https://github.com/amadoucss1998-cell/lionheart#readme",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.117.1",
    "@vercel/functions": "^3.9.9",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-session": "^2.1.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "gsap": "3.15",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1",
    "sharp": "^0.35.4",
    "three": "^0.186.0"
  }
}
